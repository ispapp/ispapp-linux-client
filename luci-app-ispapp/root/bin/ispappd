#!/usr/bin/env lua

-- ispapp daemon
-- path: /bin/ispappd
-- Simple daemon that only handles the main loop - all process management is handled by procd
local nixio = require "nixio"
local uci = require"luci.model.uci".cursor()
local sys = require "luci.sys"
local jsonc = require "luci.jsonc"

-- Variables to manage threads and their respective sleep times
local threads = {}
local running = true
local sleep_times = {
    update_interval = 30, -- Default sleep time for WISP monitor
    config_interval = 35, -- Default sleep time for connection manager
    heathcheck_interval = 40, -- Default sleep time for status reporter
    terminal_interval = 5 -- Default sleep time for terminal (faster than other threads)
}
local maxinteger = 9223372036854775807/1024

-- Function to log messages to syslog
local function log_to_syslog(level, message) 
    nixio.syslog(level, message) 
end

-- Simple logging function
local function log(message) 
    log_to_syslog("debug", "[ispappd]: " .. message) 
end

-- Function to kill any existing ispappd processes
local function kill_existing_processes()
    log("Checking for existing ispappd processes...")
    
    -- Get current process PID to avoid killing ourselves
    local current_pid = nixio.getpid()
    
    -- Find all ispappd processes using pidof command (more reliable)
    local cmd = "pidof ispappd"
    local result = sys.exec(cmd)
    
    if result and result ~= "" then
        -- Split the result by spaces to get individual PIDs
        for pid_str in result:gmatch("%S+") do
            local pid = tonumber(pid_str)
            if pid and pid ~= current_pid then
                log("Found existing ispappd process with PID: " .. pid .. ", killing it...")
                
                -- First try graceful shutdown
                local kill_result = sys.exec("kill -TERM " .. pid)
                
                -- Wait a moment for graceful shutdown
                nixio.nanosleep(2, 0)
                
                -- Check if process is still running and force kill if needed
                local check_result = sys.exec("kill -0 " .. pid .. " 2>/dev/null")
                if check_result == "" then -- Process still exists
                    log("Process " .. pid .. " still running, force killing...")
                    sys.exec("kill -KILL " .. pid)
                    nixio.nanosleep(1, 0)
                end
                
                log("Killed existing ispappd process with PID: " .. pid)
            end
        end
    else
        log("No existing ispappd processes found")
    end
end

-- RPC call function
local function rpcdCall(method, params)
    local cmd = "lua /usr/libexec/rpcd/ispapp call ".. method
    if (params and #params > 0) then
        cmd = cmd .. " " .. jsonc.stringify(params)
    end
    
    local status, result, _ = pcall(sys.exec, cmd)
    if status and result then
        log("Call " .. method .. " successfully")
        local parsed_result = jsonc.parse(result)
        return parsed_result
    else
        log("Failed to call " .. method .. " error: " ..
                (result and tostring(result) or "no result"))
        return nil
    end
end

-- Function to load configuration and get sleep times for each thread
local function load_config()
    local UpdateInterval = uci:get("ispapp", "@settings[0]", "updateInterval")
    -- Ensure minimum 30s and assign to variables
    if UpdateInterval then
        UpdateInterval = tonumber(UpdateInterval)
        if UpdateInterval and UpdateInterval >= 30 then
            sleep_times.update_interval = UpdateInterval
            sleep_times.config_interval = UpdateInterval + 5
            sleep_times.heathcheck_interval = UpdateInterval + 10
            sleep_times.terminal_interval = math.max(1, math.floor(UpdateInterval / 5)) -- Terminal runs 5x faster
        else
            sleep_times.update_interval = 30
            sleep_times.config_interval = 35
            sleep_times.heathcheck_interval = 40
            sleep_times.terminal_interval = 5 -- Default terminal interval
        end
    else
        uci:set("ispapp", "@settings[0]", "updateInterval", "30") -- Save default if missing
        sleep_times.update_interval = 30
        sleep_times.config_interval = 35
        sleep_times.heathcheck_interval = 40
        sleep_times.terminal_interval = 5
    end

    -- Commit the changes if defaults were saved
    uci:commit("ispapp")
end

-- Thread 1: WISP monitoring task
local function Update_thread()
    local count = 0
    while running do
        local success, err = pcall(function()
            count = count + 1
            if count > maxinteger then
                count = 0
            end
            log("Sending updates ..." .. " count: " .. count)
            local update = rpcdCall("update", {})
            local sentupdate = rpcdCall("sendupdate", {})
            
            if sentupdate and sentupdate.code == 200 then
                log("Sent update successfully" .. " count: " .. count)
            else
                log("Failed to send update" .. " count: " .. count)
            end
            if update and update.code == 200 then
                log("Update retreived successfully" .. " count: " .. count)
            else
                log("Failed to retreive update" .. " count: " .. count)
            end
            nixio.nanosleep(sleep_times.update_interval, 0) -- Sleep for the configured time
        end)
        
        if not success then
            log("Error in Update_thread: " .. (err or "unknown error"))
            nixio.nanosleep(5, 0) -- Sleep on error to prevent tight loop
        end
        
        coroutine.yield() -- Yield execution back to the manager after each iteration
    end
end

-- Thread 2: Connection management task
local function Config_thread()
    local count = 0
    while running do
        local success, err = pcall(function()
            count = count + 1
            if count > maxinteger then
                count = 0
            end
            log("Sending configs..." .. " count: " .. count)
            local config = rpcdCall("config", {})
            if config and config.code == 200 then
                log("Config sent successfully" .. " count: " .. count)
            else
                log("Failed to send config" .. " count: " .. count)
            end
            nixio.nanosleep(sleep_times.config_interval, 0) -- Sleep for the configured time
        end)
        
        if not success then
            log("Error in Config_thread: " .. (err or "unknown error"))
            nixio.nanosleep(5, 0) -- Sleep on error to prevent tight loop
        end
        
        coroutine.yield() -- Yield execution back to the manager after each iteration
    end
end

-- Thread 3: Status reporting task
local function HealthCheck_thread()
    local count = 0
    while running do
        local success, err = pcall(function()
            count = count + 1
            if count > maxinteger then
                count = 0
            end
            log("Reporting heath check..." .. " count: " .. count)
            local health = rpcdCall("checkconnection", {})
            if health and health.code == 200 then
                log("Health check reported successfully" .. " count: " .. count)
            else
                log("Failed to report health check" .. " count: " .. count)
                log("heath error..." ..
                        (health and jsonc.stringify(health) or "no error"))
            end
            nixio.nanosleep(sleep_times.heathcheck_interval, 0) -- Sleep for the configured time
        end)
        
        if not success then
            log("Error in HealthCheck_thread: " .. (err or "unknown error"))
            nixio.nanosleep(5, 0) -- Sleep on error to prevent tight loop
        end
        
        coroutine.yield() -- Yield execution back to the manager after each iteration
    end
end

-- Thread 4: Terminal handling task (faster than other threads)
local function Terminal_thread()
    local count = 0
    while running do
        local success, err = pcall(function()
            count = count + 1
            if count > maxinteger then
                count = 0
            end
            log("Processing terminal commands..." .. " count: " .. count)
            local terminal = rpcdCall("terminal", {})
            if terminal and terminal.code == 200 then
                log("Terminal processed successfully" .. " count: " .. count)
            else
                log("Failed to process terminal" .. " count: " .. count)
            end
            nixio.nanosleep(sleep_times.terminal_interval, 0) -- Sleep for shorter time than other threads
        end)
        
        if not success then
            log("Error in Terminal_thread: " .. (err or "unknown error"))
            nixio.nanosleep(5, 0) -- Sleep on error to prevent tight loop
        end
        
        coroutine.yield() -- Yield execution back to the manager after each iteration
    end
end

-- Main daemon loop - this is the only function that runs
local function run_daemon()
    log("Starting ispappd daemon...")
    
    -- Load the sleep times from config
    load_config()
    log(
        "Thread Sleep Times: update interval = " .. sleep_times.update_interval ..
            " s, " .. "config interval = " .. sleep_times.config_interval ..
            " s, " .. "heath check interval = " ..
            sleep_times.heathcheck_interval .. " s, " .. "terminal interval = " ..
            sleep_times.terminal_interval .. " s")

    -- Create coroutines (threads)
    threads[1] = coroutine.create(Update_thread)
    threads[2] = coroutine.create(Terminal_thread)
    threads[3] = coroutine.create(Config_thread)
    threads[4] = coroutine.create(HealthCheck_thread)
    
    local function safe_resume(thread, name)
        local ok, err = coroutine.resume(thread)
        if not ok then
            log_to_syslog("err", "[ispappd]: " .. name .. " error: " .. (err or "unknown error"))
            return false
        end
        return true
    end

    local function watch_and_restart_threads()
        for i, thread in ipairs(threads) do
            if coroutine.status(thread) == "dead" then
                log("Thread " .. i .. " is dead, restarting it...")
                if i == 1 then
                    threads[i] = coroutine.create(Update_thread)
                elseif i == 2 then
                    threads[i] = coroutine.create(Config_thread)
                elseif i == 3 then
                    threads[i] = coroutine.create(HealthCheck_thread)
                else
                    threads[i] = coroutine.create(Terminal_thread)
                end
            end
        end
    end

    -- Main loop - runs forever until terminated by procd
    while running do
        watch_and_restart_threads()
        local active_threads = 0
        for i, thread in ipairs(threads) do
            local status = coroutine.status(thread)
            if status == "suspended" then
                if safe_resume(thread, "Thread " .. i) then
                    active_threads = active_threads + 1
                end
            elseif status == "dead" then
                log("Thread " .. i .. " died unexpectedly, will be restarted on next cycle")
            else
                active_threads = active_threads + 1
            end
        end
        
        -- If no threads are active, something went wrong
        if active_threads == 0 then
            log("All threads are dead, restarting all threads...")
            nixio.nanosleep(1, 0) -- Wait a bit before restarting
        end
        
        nixio.nanosleep(0, 100000000) -- Short sleep to avoid tight loop
    end
    
    log("Daemon loop ended")
end

-- Signal handler for graceful shutdown
local function handle_signal(signum)
    log("Received signal " .. signum .. ", shutting down gracefully...")
    running = false
end

-- Register signal handlers
nixio.signal(nixio.const.SIGTERM, "dfl")
nixio.signal(nixio.const.SIGINT, "dfl")

-- Main execution - just run the daemon
log("ispappd starting...")
kill_existing_processes()
run_daemon()
log("ispappd stopped.")
